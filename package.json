{
  "name": "evoverse",
  "version": "0.0.1",
  "description": "agent 世界自演进引擎 —— dsh 插件",
  "type": "module",
  "private": true,
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:web": "tsc --noEmit && vite build",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build": "pnpm build:plugin",
    "smoke": "esbuild scripts/smoke.ts --bundle --format=esm --platform=node --outfile=/tmp/evoverse-smoke.mjs --log-level=error && node /tmp/evoverse-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
